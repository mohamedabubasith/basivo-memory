#!/bin/sh
# Run a basivo-memory script with whatever Python 3 this machine has:
# python3 (macOS/Linux), python or py (Windows). Never fails a hook.
here=$(dirname "$0")
script="$1"; shift
for p in python3 python "py -3"; do
  if $p -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    exec $p "$here/$script" "$@"
  fi
done
echo "basivo-memory: Python 3.8+ not found (install it: https://www.python.org/downloads/)" >&2
exit 0
